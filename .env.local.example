# Upstash Redis 配置
# 在 Vercel 项目设置中添加这些环境变量
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# 备用环境变量名（如果上面不工作）
cat_KV_REST_API_READ_ONLY_TOKEN=your-read-only-token
cat_KV_REST_API_TOKEN=your-api-token
cat_KV_REST_API_URL=https://your-redis-url.upstash.io
cat_KV_URL=redis://default:your-redis-url@your-redis-host:6379

# WalletConnect 配置
# 在 Vercel 项目设置中添加环境变量
# 需要在 https://cloud.walletconnect.com 注册获取真实的 Project ID
VITE_WALLETCONNECT_PROJECT_ID=your-real-walletconnect-project-id
