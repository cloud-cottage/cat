{
  "name": "diamond",
  "displayName": "钻石手",
  "description": "经典钻石手主题，适合长期持有者",
  "version": "1.0.0",
  "author": "Cloud Cottage",
  "colors": {
    "primary": "#FF8C42",
    "secondary": "#1C6E9C",
    "accent": "#FF6B35",
    "surface": "rgba(255, 255, 255, 0.95)",
    "text": {
      "primary": "#2C3E50",
      "secondary": "#4A5568",
      "muted": "#7F8C8D",
      "white": "#FFFFFF"
    }
  },
  "layout": {
    "container": {
      "width": "1800px",
      "maxWidth": "100%",
      "margin": "0 auto",
      "minHeight": "100vh",
      "padding": "2rem 1rem"
    },
    "grid": {
      "columns": 6,
      "rows": 9,
      "columnSize": "1fr",
      "rowHeight": "280px",
      "gap": "1rem"
    },
    "module": {
      "background": "#E6E9E7",
      "borderRadius": "16px",
      "borderWidth": "2px",
      "padding": "1.5rem"
    }
  },
  "background": {
    "type": "pattern",
    "value": "/images/diamond-background.png",
    "size": "200px 200px",
    "repeat": "repeat",
    "attachment": "fixed"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontSize": "16px",
    "lineHeight": "1.5"
  },
  "effects": {
    "shadow": "0 8px 32px rgba(255, 140, 66, 0.15)",
    "hoverShadow": "0 12px 40px rgba(255, 140, 66, 0.25)",
    "glow": "0 0 20px rgba(255, 140, 66, 0.3)"
  },
  "animations": {
    "module": {
      "hover": {
        "transform": "translateY(-6px) scale(1.03) rotateX(2deg)",
        "filter": "brightness(1.05)"
      }
    },
    "title": {
      "gradient": "linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 25%, var(--theme-primary) 50%, var(--theme-secondary) 75%, var(--theme-primary) 100%)"
    }
  },
  "metadata": {
    "category": "classic",
    "tags": ["diamond", "holder", "long-term"],
    "difficulty": "beginner",
    "popularity": "high"
  }
}
